{
  "name": "brutus-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tick-deterministic Brutus (OSRS NPC 15626) simulator: headless engine with RSProx log-replay verification, plus a Three.js client.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check-collision": "tsx scripts/check-collision.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
